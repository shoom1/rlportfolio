# Results — ignore the directory contents, but allow the canonical CSV
# that the notebook + README depend on. (Use `results/*` rather than
# `results/`; otherwise the directory rule blocks all re-includes.)
results/*
*.png
*.pdf
# Keep committed figures used in README.
!figures/*.png
# Keep the canonical walk-forward CSV that the notebook + README use.
!results/walk_forward_tech5.csv

